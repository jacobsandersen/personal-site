---
import PageTitle from "~/components/PageTitle.astro";
import HFeedRenderer from "~/components/post/hfeed/HFeedRenderer.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient from "~/lib/bastion";
import { PostMf2Type } from "~/types/bastion";

const { pathname } = Astro.url;

let { year } = Astro.params;
let yearNum = Number.parseInt(year!, 10)
if (Number.isNaN(yearNum)) {
  return Astro.rewrite("/400")
}

const posts = await DefaultBastionClient.posts().type(PostMf2Type.H_ENTRY).year(yearNum).query()

const title = `Posts from ${year}`;
---

<BaseLayout title={title}>
  <PageTitle
    title={title}
    crumbs={["Home:/", `${year}:${pathname}`]} />
    
  <HFeedRenderer feed={posts} feedInfo={{ title, url: `/${year}`, headerConfig: { level: 2, hidden: true } }} />
</BaseLayout>
