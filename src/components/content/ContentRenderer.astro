---
import TextRenderer from './TextRenderer.astro'
import HtmlRenderer from './HtmlRenderer.astro'

interface Props {
    content: string[],
    html: boolean,
    class?: string,
    preview?: boolean,
    raw?: boolean
}

const { content, html, class: className = "", preview = false, raw = false } = Astro.props as Props
---

{content.map(piece => {
    if (html) {
        return <HtmlRenderer html={piece} preview={preview} class={className} />
    } else {
        return <TextRenderer text={piece} preview={preview} raw={raw} class={className} />
    }
})}
