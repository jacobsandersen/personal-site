---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import { determinePageInfo } from "~/lib/bastion"
import { indexFeed } from "~/lib/feeds";
import { getPage, getPageLinkFn } from "~/util/page";

const feed = indexFeed()

const posts = await feed.build()
  .page(getPage(Astro.url))
  .perPage(10)
  .query()

const pageInfo = determinePageInfo(posts.pagination)

const feedInfo = {
  title: feed.title,
  url: feed.path,
  headerConfig: {
    level: 3,
    hidden: true,
  },
};
---

<BaseLayout title="Home" feed={feed}>
  <div class="tw:flex tw:flex-col tw:gap-y-6">
    <section>
      <!-- <h2 class="tw:text-3xl tw:font-bold tw:mb-3">lately</h2> -->
      <PaginatedFeed
        feed={posts}
        feedInfo={feedInfo}
        pageInfo={pageInfo}
        pageLink={getPageLinkFn(Astro.url)}
      />
    </section>
  </div>
</BaseLayout>
