---
import UnknownFormatRenderer from "./UnknownFormatRenderer.astro";
import PostFrame from "./PostFrame.astro";
import PostTypeBody from "./PostTypeBody.astro";
import { createHEntryExtractor } from "~/lib/extractor";
import { DocumentRenderProps, RenderMethod } from "~/types/mf2-rendering";

export interface Props extends DocumentRenderProps {}

const { doc, class: className, renderMethod = RenderMethod.Permalink } = Astro.props as Props;
const extractor = doc.h === "h-entry" ? createHEntryExtractor(doc) : null;
---

{
  extractor ? (
    <PostFrame extractor={extractor} renderMethod={renderMethod} class={className}>
      <PostTypeBody extractor={extractor} renderMethod={renderMethod} />
    </PostFrame>
  ) : (
    <UnknownFormatRenderer doc={doc} renderMethod={renderMethod} class={className} />
  )
}
