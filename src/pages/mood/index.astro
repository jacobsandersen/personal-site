---
import PageTitle from "~/components/PageTitle.astro";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { determinePageInfo } from "~/lib/bastion";
import { typeFeed } from "~/lib/feeds";
import { PostType } from "~/types/bastion";
import { getPage, getPageLinkFn } from "~/util/page";

const feed = typeFeed(PostType.MOOD)

const entries = await feed.build()
  .page(getPage(Astro.url))
  .perPage(10)
  .query()

const pageInfo = determinePageInfo(entries.pagination)

const feedInfo = {
  title: feed.title,
  url: feed.path,
  headerConfig: {
    level: 2,
    hidden: true,
  },
};
---

<BaseLayout title={feed.title} feed={feed}>
  <PageTitle
    title="My Moodlog"
    crumbs={["Home:/", `${feed.title}:${feed.path}`]} />
  <PaginatedFeed
    feed={entries}
    feedInfo={feedInfo}
    pageInfo={pageInfo}
    pageLink={getPageLinkFn(Astro.url)}
  />
</BaseLayout>
