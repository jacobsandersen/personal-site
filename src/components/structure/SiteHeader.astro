---
import { env } from "~/lib/env";
import Link from "../util/Link.astro";

const { pathname } = Astro.url;

interface NavLink {
  text: string,
  href: string,
  activeIf: (pathname: string) => boolean
}

const navLinks: NavLink[] = [
  { text: "home", href: "/", activeIf: (pathname) => pathname === '/' },
  { text: "workshop", href: "/workshop", activeIf: (pathname) => pathname.startsWith("/workshop") },
  { text: "reading", href: "/reading", activeIf: (pathname) => pathname.startsWith("/reading") },
  { text: "travels", href: "/travels", activeIf: (pathname) => pathname.startsWith("/travels") },
  { text: "about", href: "/about", activeIf: (pathname) => pathname.startsWith("/about") },
  { text: "tags", href: "/tagged", activeIf: (pathname) => pathname.startsWith("/tagged") }
]
---

<aside class="tw:col-span-4 tw:flex tw:flex-col tw:mb-2">
  <section class="h-card tw:flex tw:gap-x-4">
    <div>
      <div class="tw:flex tw:gap-x-4 tw:items-center tw:mb-4">
        <div class="tw:h-10 tw:w-10 tw:overflow-hidden tw:rounded-full">
          <img class="u-photo tw:h-full tw:w-full tw:object-cover tw:origin-[44%_49%] tw:scale-250 tw:rounded-full" src="/images/portrait/300.webp" alt="portrait of jacob" />
        </div>
        <h1 class="tw:text-2xl tw:font-brand tw:text-powder-blue">
          <a href={env.PUBLIC_URL} class="u-url" rel="me">
            <span class="p-name">
              <span class="p-given-name">jacob</span> <span class="p-family-name">andersen</span>
            </span>
          </a>
        </h1>
      </div>
      <p class="p-note tw:leading-5">
        Hello, I'm Jacob. I'm a software engineer, a reader, a traveller, a learner, and more.
        This is my little corner of the internet &mdash; a little bit of a
        garden, a workshop, a notebook, and a storage container, all in one.
        Feel free to take a look around.
      </p>
    </div>
  </section>
  <nav class="tw:text-xs">
    <ul class="tw:inline-flex tw:flex-col tw:gap-x-3">
      {
        navLinks.map((link) => (
          <li class:list={{ "tw:font-bold": link.activeIf(pathname) }}>
            <Link href={link.href}>{link.text}</Link>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
