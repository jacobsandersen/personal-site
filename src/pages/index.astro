---
import LinkCard from "~/components/util/LinkCard.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { RenderMethod } from "~/types/mf2-rendering";
import NowReading from "~/components/ssr/NowReading.astro";
import NowPlaying from "~/components/ssr/NowPlaying.astro";
import Mf2Extractor from "~/lib/extractor/Mf2Extractor";
import HFeedRenderer from "~/components/post/hfeed/HFeedRenderer.astro";
import Bastion from "~/lib/bastion"
import {PostMf2Type, PostType, NoteType} from "~/types/bastion"

const posts = await Bastion.posts()
  .type(PostMf2Type.H_ENTRY)
  .perPage(20)
  .query()

const { items: moodEntries } = await Bastion.posts()
  .type(PostMf2Type.H_ENTRY)
  .subtype(PostType.NOTE)
  .noteType(NoteType.MOOD)
  .perPage(1)
  .query()

const latestMood = moodEntries.length === 1 ?
  new Mf2Extractor(moodEntries[0]).getMood() ?? "unknown" :
  "unknown";

const feedInfo = {
  title: "Recent Posts",
  url: "/",
  headerConfig: {
    level: 3,
    hidden: true,
  },
};
---

<BaseLayout title="Home">
  <div class="tw:flex tw:flex-col tw:gap-y-6">
    <section class="tw:pt-4">
      <h1 class="tw:text-6xl tw:font-brand tw:text-powder-blue tw:mb-4">hi, i'm jacob</h1>
      <p class="tw:tracking-wide tw:leading-7">
        I'm a software engineer, a reader, a traveller, a learner, and more.
        This is my little corner of the internet &mdash; a little bit of a
        garden, a workshop, a notebook, and a storage container, all in one.
        Feel free to take a look around.
      </p>
    </section>
    <section>
      <h2 class="tw:text-3xl tw:font-bold tw:mb-3">knick knacks</h2>
      <div class="tw:grid tw:grid-cols-2 tw:gap-4">
        <LinkCard href="/reading" class="tw:flex tw:flex-col tw:gap-y-2">
          <h3 slot="title" class="tw:text-xl">reading</h3>
          <div class="tw:contents tw:text-xs">
            <p>no spoilers on my unreads/in-progress please!</p>
            <NowReading />
          </div>
        </LinkCard>
        <LinkCard href="/jams" class="tw:flex tw:flex-col tw:gap-y-2">
          <h3 slot="title" class="tw:text-xl">jams</h3>
          <div class="tw:contents tw:text-xs">
            <p>come check out the jams</p> 
            <NowPlaying />
          </div>
        </LinkCard>
        <LinkCard href="/mood" class="tw:flex tw:flex-col tw:gap-y-2">
          <h3 slot="title" class="tw:text-xl">mood</h3>
          <p class="tw:text-xs"><span class="tw:font-bold">most recently: </span>{latestMood}</p>
        </LinkCard>
        <LinkCard href="/workshop" class="tw:flex tw:flex-col tw:gap-y-2">
          <h3 slot="title" class="tw:text-xl">workshop</h3>
          <p class="tw:text-xs">
            this is where i put my projects and other stuff i'm working on
          </p>
        </LinkCard>
      </div>
    </section>
    <section>
      <h2 class="tw:text-3xl tw:font-bold tw:mb-3">lately</h2>
      <HFeedRenderer
        feed={posts}
        renderMethod={RenderMethod.Minimal}
        feedInfo={feedInfo}
        class="tw:flex tw:flex-col tw:gap-y-6"
        gridCols={1}
      />
    </section>
  </div>
</BaseLayout>
