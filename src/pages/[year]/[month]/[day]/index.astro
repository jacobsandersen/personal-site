---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageTitle from "~/components/PageTitle.astro";
import DefaultBastionClient from "~/lib/bastion";
import { PostMf2Type } from "~/types/bastion";
import HFeedRenderer from "~/components/post/hfeed/HFeedRenderer.astro";
import { parseAdhoc } from "~/util/dates";

const { pathname } = Astro.url;

const { year, month, day } = Astro.params;

let yearNum = Number.parseInt(year!, 10)
if (Number.isNaN(yearNum)) {
  return Astro.rewrite("/400")
}

let monthNum = Number.parseInt(month!, 10)
if (Number.isNaN(monthNum)) {
  return Astro.rewrite("/400")
}

let dayNum = Number.parseInt(day!, 10)
if (Number.isNaN(dayNum)) {
  return Astro.rewrite("/400")
}

const posts = await DefaultBastionClient.posts().type(PostMf2Type.H_ENTRY).year(yearNum).month(monthNum).day(dayNum).query()

const date = new Date()
date.setFullYear(yearNum)
date.setMonth(monthNum - 1)
date.setDate(dayNum)

const formattedMonth = parseAdhoc(date, 'MMMM')
const formattedDate = parseAdhoc(date, 'MMMM DD, YYYY')

const title = `Posts from ${formattedDate}`;
---

<BaseLayout title={title}>
    <PageTitle title={title} crumbs={["Home:/", `${year}:/${year}`, `${formattedMonth}:/${year}/${month}`, `${day}:${pathname}`]} />
    <HFeedRenderer feed={posts} feedInfo={{title, url:`/${year}/${month}/${day}`, headerConfig: { level: 2, hidden: true }}} />
</BaseLayout>
