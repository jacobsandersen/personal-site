---
import SiteSidebar from "~/components/structure/SiteSidebar.astro";
import SiteFooter from "~/components/structure/SiteFooter.astro";
import "~/styles/global.css";
import { env } from "~/lib/env";
import type { FeedDefinition } from "~/lib/feeds";

interface Props {
	title?: string;
	/** When set, advertises the h-feed (self) and its Atom twin (alternate) in the head. */
	feed?: FeedDefinition;
}

const { title, feed } = Astro.props as Props;
const publicUrl = env.PUBLIC_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="fediverse:creator" content="@simpleauthority@mastodon.social">
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="pgpkey" href="/gpg.pub.txt" />
		<link rel="authorization_endpoint" href=`${env.BASTION_PUBLIC_URL}/indieauth/auth` />
		<link rel="token_endpoint" href=`${env.BASTION_PUBLIC_URL}/indieauth/token` />
    <link rel="indieauth-metadata" href=`${env.BASTION_PUBLIC_URL}/.well-known/oauth-authorization-server` />
		<link rel="micropub" href=`${env.BASTION_PUBLIC_URL}/micropub` />
    <link rel="webmention" href=`${env.BASTION_PUBLIC_URL}/webmention` />
    <link rel="microsub" href=`${env.BASTION_PUBLIC_URL}/microsub` />
    <link rel="hub" href="https://pubsubhubbub.superfeedr.com/">
		{feed && <link rel="self" href={`${publicUrl}${feed.path}`} />}
		{feed && <link rel="alternate" type="application/atom+xml" title={feed.title} href={`${publicUrl}${feed.atomPath}`} />}
		<slot name="additionalHead" />
		<title>{title ?? "Unnamed Page"} &ndash; Jacob Andersen</title>
	</head>
	<body class="tw:min-h-screen tw:pt-4 tw:px-4 tw:md:px-6 tw:max-w-[70rem] tw:mx-auto tw:flex tw:flex-col">
		<div class="tw:flex-1 tw:grid tw:grid-cols-1 tw:md:grid-cols-[17rem_minmax(0,1fr)] tw:gap-x-10">
			<SiteSidebar />
			<main class="tw:min-w-0 tw:pb-6">
				<slot />
			</main>
		</div>
		<SiteFooter />
	</body>
</html>
