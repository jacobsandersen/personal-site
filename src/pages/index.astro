---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Mf2Extractor from "~/lib/extractor/Mf2Extractor";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import Bastion, { determinePageInfo } from "~/lib/bastion"
import {PostMf2Type, PostType} from "~/types/bastion"
import { getPage, getPageLinkFn } from "~/util/page";

const posts = await Bastion.posts()
  .h(PostMf2Type.ENTRY)
  .page(getPage(Astro.url))
  .perPage(5)
  .query()

const pageInfo = determinePageInfo(posts.pagination)

const { items: moodEntries } = await Bastion.posts()
  .h(PostMf2Type.ENTRY)
  .type(PostType.MOOD)
  .perPage(1)
  .query()

const latestMood = moodEntries.length === 1 ?
  new Mf2Extractor(moodEntries[0]).getMood() ?? "unknown" :
  "unknown";

const feedInfo = {
  title: "Recent Posts",
  url: "/",
  headerConfig: {
    level: 3,
    hidden: true,
  },
};
---

<BaseLayout title="Home">
  <div class="tw:flex tw:flex-col tw:gap-y-6">
