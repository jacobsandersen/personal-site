---
import PageTitle from "~/components/PageTitle.astro";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient, { determinePageInfo } from "~/lib/bastion";
import { PostMf2Type } from "~/types/bastion";
import { getPage, getPageLinkFn } from "~/util/page"

const posts = await DefaultBastionClient.posts().h(PostMf2Type.ENTRY).untagged().page(getPage(Astro.url)).query()
const pageInfo = determinePageInfo(posts.pagination)

const title = `Uncategorized Posts`
---

<BaseLayout title={title}>
  <PageTitle
    title={title}
    subtitle="These posts are uncategorized. You should nag me to give them a home! Hopefully there's nothing here." 
    crumbs={["Home:/", "Uncategorized:/uncategorized"]} />
    
  <PaginatedFeed 
    feed={posts} 
    feedInfo={{ title, url: `/uncategorized`, headerConfig: { level: 2, hidden: true } }}
    pageInfo={pageInfo}
    pageLink={getPageLinkFn(Astro.url)}
  />
</BaseLayout>