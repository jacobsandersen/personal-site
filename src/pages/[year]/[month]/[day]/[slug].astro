---
import DefaultBastionClient from "~/lib/bastion";
import { parseAdhoc } from "~/util/dates";
import { isPostGone } from "~/types/bastion"
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import PostRenderer from "~/components/post/PostRenderer.astro";
import { env } from "~/lib/env";

const { year, month, day } = Astro.params;

const post = await DefaultBastionClient.post().url(`${env.PUBLIC_URL}${Astro.url.pathname}`).query()
if (!post) {
  return Astro.rewrite("/404")
}

if (isPostGone(post)) {
  return Astro.rewrite("/410")
}

const date = new Date()
date.setFullYear(Number(year))
date.setMonth(Number(month) - 1)
date.setDate(Number(day))

const formattedMonth = parseAdhoc(date, 'MMMM')
---

<BaseLayout title={post.name ?? `Post on ${year}-${month}-${day}`}>
  <Breadcrumb
    class="tw:col-span-12 tw:mb-4"
    crumbs={[
      "Home:/", `${year}:/${year}`, `${formattedMonth}:/${year}/${month}`, `${day}:/${year}/${month}/${day}`, "This Post"
    ]}
  />
  <PostRenderer doc={post} />
</BaseLayout>
