---
import PageTitle from "~/components/PageTitle.astro";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient, { determinePageInfo } from "~/lib/bastion";
import { PostMf2Type } from "~/types/bastion";
import { getPaginatorData } from "~/util/page";

const { category } = Astro.params;
if (!category) {
  return Astro.redirect("/400")
}

const paginatorData = getPaginatorData(Astro.url)
const posts = await DefaultBastionClient.posts().h(PostMf2Type.ENTRY).tag(category).page(paginatorData.page).query()
const pageInfo = determinePageInfo(posts.pagination)

const title = `Posts tagged with #${category}`;
---

<BaseLayout title={title}>
    <PageTitle 
      title={title} 
      crumbs={["Home:/", "Post Tags:/tagged", `#${category}:/tagged/${category}`]} />
      
    <PaginatedFeed
      feed={posts}
      feedInfo={{ title, url: `/tagged/${category}`, headerConfig: { level: 2, hidden: true } }}
      pageInfo={pageInfo}
      pageLink={paginatorData.pageLink}
    />
</BaseLayout>
