---
import Link from "~/components/util/Link.astro";
import { RenderMethod } from "~/types/mf2-rendering";
import PostRenderer from "../PostRenderer.astro";
import type { FeedDto } from "~/types/bastion";

export interface FeedInfo {
  title: string, 
  url: string, 
  headerConfig?: { 
    hidden?: boolean, 
    level?: number, 
    class?: string 
  }
}

interface Props {
  feed: FeedDto
  feedInfo?: FeedInfo
  class?: string
  containerClass?: string
  itemClass?: string
}

const { feedInfo, feed, class: className, containerClass, itemClass } = Astro.props as Props;
const headerConf = feedInfo?.headerConfig ?? { level: 1, class: "" };
const headerHidden = headerConf.hidden ?? false;
const headerLevel = Math.min(Math.max(headerConf.level ?? 1, 1), 6)
const HeaderElem = `h${headerLevel}`;
const headerClass = headerConf.class ?? "";
let finalContainerClass = containerClass ? containerClass : "tw:flex tw:flex-col tw:gap-y-6"
---

<section class:list={["h-feed", className]}>
    {feedInfo && <HeaderElem class:list={["tw:text-2xl", "tw:font-bold", headerClass, { "tw:hidden": headerHidden }]}><Link href={feedInfo.url}>{feedInfo.title}</Link></HeaderElem>}
    <div class:list={finalContainerClass}>
      { feed.items.length > 0 
        ? feed.items.map((post) => (
            <PostRenderer doc={post} renderMethod={RenderMethod.Feed} class={itemClass} />
        ))
        : <p>There's nothing here right now. Keep an eye out for later!</p>
      }
    </div>
    <slot name="feed-paginator" />
</section>
