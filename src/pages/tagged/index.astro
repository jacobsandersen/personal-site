---
import PageTitle from "~/components/PageTitle.astro";
import Link from "~/components/util/Link.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient from "~/lib/bastion";

const tags = await DefaultBastionClient.tags().query()
---

<BaseLayout title="Post Tags">
  <PageTitle 
    title="Post Tags" 
    subtitle="This page lists all of the tags/categories that I have ever used in making a post, and links back to those posts." 
    crumbs={["Home:/", "Post Tags:/tagged"]} />
  <ul class="tw:grid tw:grid-cols-3 tw:gap-1">
    {
      tags.tags.map((tag) => (
        <li>
          <Link href={`/tagged/${tag.tag}`}>#{tag.tag} ({tag.count})</Link>
        </li>
      ))
    }
  </ul>
</BaseLayout>
