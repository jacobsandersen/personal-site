---
import PageTitle from "~/components/PageTitle.astro";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient, { determinePageInfo } from "~/lib/bastion";
import { PostMf2Type, PostType } from "~/types/bastion";
import { getPage, getPageLinkFn } from "~/util/page";

const entries = await DefaultBastionClient.posts().h(PostMf2Type.ENTRY).type(PostType.MOOD).page(getPage(Astro.url)).query()
const pageInfo = determinePageInfo(entries.pagination)

const feedInfo = {
  title: "Moodlog",
  url: "/mood",
  headerConfig: {
    level: 2,
    hidden: true,
  },
};
---

<BaseLayout title="Moodlog">
  <PageTitle
    title="My Moodlog"
    crumbs={["Home:/", "Moodlog:/mood"]} />
  <PaginatedFeed
    feed={entries}
    feedInfo={feedInfo}
    pageInfo={pageInfo}
    pageLink={getPageLinkFn(Astro.url)}
  />
</BaseLayout>