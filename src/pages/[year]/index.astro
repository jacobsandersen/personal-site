---
import PageTitle from "~/components/PageTitle.astro";
import PaginatedFeed from "~/components/post/hfeed/PaginatedFeed.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient, { determinePageInfo } from "~/lib/bastion";
import { PostMf2Type } from "~/types/bastion";
import { getPaginatorData } from "~/util/page";

const { pathname } = Astro.url;

let { year } = Astro.params;
let yearNum = Number.parseInt(year!, 10)
if (Number.isNaN(yearNum)) {
  return Astro.rewrite("/400")
}

const paginatorData = getPaginatorData(Astro.url)
const posts = await DefaultBastionClient.posts().h(PostMf2Type.ENTRY).year(yearNum).page(paginatorData.page).query()
const pageInfo = determinePageInfo(posts.pagination)

const title = `Posts from ${year}`;
---

<BaseLayout title={title}>
  <PageTitle
    title={title}
    crumbs={["Home:/", `${year}:${pathname}`]} />
    
  <PaginatedFeed 
    feed={posts} 
    feedInfo={{ title, url: `/${year}`, headerConfig: { level: 2, hidden: true } }} 
    pageInfo={pageInfo}
    pageLink={paginatorData.pageLink}
  />
</BaseLayout>
