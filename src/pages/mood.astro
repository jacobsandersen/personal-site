---
import PageTitle from "~/components/PageTitle.astro";
import HFeedRenderer from "~/components/post/hfeed/HFeedRenderer.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import DefaultBastionClient from "~/lib/bastion";
import { PostMf2Type, PostType } from "~/types/bastion";
import { RenderMethod } from "~/types/mf2-rendering";

const entries = await DefaultBastionClient.posts().h(PostMf2Type.ENTRY).type(PostType.MOOD).query()

const feedInfo = {
  title: "Moodlog",
  url: "/mood",
  headerConfig: {
    level: 2,
    hidden: true,
  },
};
---

<BaseLayout title="Moodlog">
  <PageTitle
    title="My Moodlog"
    crumbs={["Home:/", "Moodlog:/mood"]} />
  <HFeedRenderer
    feed={entries}
    renderMethod={RenderMethod.Preview}
    feedInfo={feedInfo}
    class="tw:flex tw:flex-col tw:gap-y-6"
  />
</BaseLayout>