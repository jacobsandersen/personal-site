---
import MicroformatRenderer from "~/components/microformat/MicroformatRenderer.astro";
import DefaultBastionClient from "~/lib/bastion";
import { parseAdhoc } from "~/util/dates";
import { isPostGone } from "~/types/bastion"

const { pathname } = Astro.url;

const { year, month, day } = Astro.props;

const post = await DefaultBastionClient.post().url(Astro.url.toString()).query()
if (!post) {
  return Astro.rewrite("/404")
}

if (isPostGone(post)) {
  return Astro.rewrite("/410")
}

const date = new Date()
date.setFullYear(Number(year))
date.setMonth(Number(month) - 1)
date.setDate(Number(day))

const formattedMonth = parseAdhoc(date, 'MMMM')
---

<MicroformatRenderer 
  doc={post} 
  crumbs={[
    "Home:/", `${year}:/${year}`, `${formattedMonth}:/${year}/${month}`, `${day}:/${year}/${month}/${day}`, "This Post"
  ]} 
/>

